<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Overwatch</title>
<link rel="stylesheet" href="/static/report.css">
</head>
<body>
<div class="unhinged-marquee">🚨 LIVE FINANCIAL DAMAGE 🚨 GPU GO BRRRR 💸 STATUS-BASED MEME ENGINE ONLINE 🧠</div>
<div class="meme-layer" aria-hidden="true">{{ meme_layer_html | safe }}</div>
<main>
  <div class="toolbar">
    <div>
      <h1>Overwatch</h1>
      <div class="subtitle">{{ row_count }} cloud resources · W&amp;B enrichment lookup limit {{ requested_limit }} · generated {{ generated_at }}</div>
    </div>
    <label>Theme
      <select class="theme-picker" aria-label="Theme">
        <option value="system">System</option>
        <option value="dark">Dark</option>
        <option value="light">Light</option>
        <option value="unhinged">Unhinged</option>
      </select>
    </label>
  </div>
  {% if warnings %}<ul class="warnings" role="status">{% for warning in warnings %}<li>{{ warning }}</li>{% endfor %}</ul>{% endif %}
  <div class="money-strip">
    <div class="money-card"><div class="money-label">Live burn rate</div><div class="money-value">{{ total_hourly_cost }}/hr</div></div>
    <div class="money-card"><div class="money-label">Spent so far</div><div class="money-value">{{ total_spent }}</div></div>
    <div class="money-card"><div class="money-label">Active projected total</div><div class="money-value">{{ active_projected_cost }}</div></div>
  </div>
  <div class="table-wrap"><table>
    <thead><tr><th>User / project / run</th><th>Status<br><span class="muted">W&amp;B / Sky</span></th><th>Progress<br><span class="muted">throughput</span></th><th>Retries<br><span class="muted">preempt | error</span></th><th>Started<br><span class="muted">estimated finish (PT)</span></th><th>Elapsed<br><span class="muted">time left</span></th><th>Cost<br><span class="muted">spent / projected · hourly</span></th><th>Cloud / region</th><th>Links</th></tr></thead>
    <tbody>{{ rows_html | safe }}</tbody>
  </table></div>
  <details open>
    <summary>TrainConfig differences ({{ config_field_count }} project-specific fields)</summary>
    {{ config_sections_html | safe }}
  </details>
</main>
<aside class="log-drawer" aria-hidden="true">
  <div class="log-header"><div class="log-title">Live logs</div><button class="log-close" type="button">Close</button></div>
  <pre class="log-output"></pre>
</aside>
<script src="/static/report.js"></script>
</body>
</html>
